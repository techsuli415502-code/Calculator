# Example environment variables for the Camel Calculator.
# Copy this file to .env (local) or set them in your Vercel project settings.

# Required by Prisma during postinstall (prisma generate).
# Use a placeholder for SQLite if you don't need the database on Vercel.
# Vercel's filesystem is read-only, so SQLite will not persist on Vercel.
# The camel calculator itself does not use the database.
DATABASE_URL="file:./dev.db"
